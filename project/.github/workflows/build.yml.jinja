name: Build

on: [push, pull_request]

env:
  FORCE_COLOR: 1
  RUFF_OUTPUT_FORMAT: github

jobs:
  test:
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 30
    # The newest entry is a CPython pre-release: test it early, but don't let it block the build.
    # When a new CPython ships: bump this version and the matrix range end (stable versions must pass).
    continue-on-error: {% raw %}${{ matrix.python_version == '3.16' }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        python_version: [{% for minor in range(python_minimum_version.split('.')[1] | int, 17) %}"3.{{ minor }}"{{ ", " if not loop.last }}{% endfor %}]
        os: ["ubuntu-latest", "macos-latest", "windows-latest"]
    steps:
      - name: Check out repository
        uses: actions/checkout@v7
{% if libraries_use_qt %}

      - uses: tlambert03/setup-qt-libs@v1
      # *alternative*:
      # - uses: pyvista/setup-headless-display-action@v2
      #   with:
      #     qt: true

{% endif %}
      - name: Set up Python {% raw %}${{ matrix.python_version }}{% endraw %}
        uses: actions/setup-python@v7
        with:
          python-version: {% raw %}${{ matrix.python_version }}{% endraw %}
          allow-prereleases: true

      - name: Install uv
        uses: astral-sh/setup-uv@v10.4.0
        with:
          enable-cache: true
          cache-dependency-glob: pyproject.toml
          cache-suffix: {% raw %}py${{ matrix.python_version }}{% endraw %}
          python-version: {% raw %}${{ matrix.python_version }}{% endraw %}

      - name: Install dependencies (uv sync)
        run: uv sync --all-extras --no-group docs

      # ruff / ty come from the pinned `lint` group, same versions as pre-commit.
      - name: Check for code issues (ruff check)
        run: uv run --no-group docs ruff check .

      - name: Check code format (ruff format)
        run: uv run --no-group docs ruff format --check .

      - name: Static type checking (ty)
        run: uv run --no-group docs ty check

      - name: Run tests
        run: uv run --no-group docs pytest --cov-report=xml --cov=src/{{ python_package_import_name }}/ --cov-report=term-missing

      - name: Upload test results to Codecov
        # The upload sometimes hangs; never let it fail or block the build.
        timeout-minutes: 5
        continue-on-error: true
        uses: codecov/codecov-action@v7
        with:
          fail_ci_if_error: false
          verbose: true

  release:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    needs: test
    if: startsWith(github.ref, 'refs/tags/')
    permissions:
      # this permission is mandatory for trusted publishing
      id-token: write
      contents: write
    steps:
      - name: Check out repository
        uses: actions/checkout@v7
        with:
          fetch-depth: 0  # the whole history, so the notes cover everything since the last tag

      - name: Set up Python
        uses: actions/setup-python@v7
        with:
          python-version: "{{ python_minimum_version }}"

      - name: Install uv
        uses: astral-sh/setup-uv@v10.4.0
        with:
          enable-cache: true
          cache-dependency-glob: pyproject.toml
          cache-suffix: {% raw %}py${{ matrix.python_version }}{% endraw %}

      - name: Build package
        run: uv build

      - name: Generate release notes
        # From the Conventional Commits since the previous tag (cliff.toml)
        run: uvx git-cliff --latest --strip header --output release-notes.md

      - name: Publish package distributions to PyPI
        uses: pypa/gh-action-pypi-publish@release/v1

      - name: Release package on GitHub
        uses: ncipollo/release-action@v1
        with:
          bodyFile: release-notes.md
          artifacts: dist/*.whl,dist/*.tar.gz
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
